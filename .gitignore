# Staging folder for restaurant logo files before they're uploaded to
# Supabase Storage (plates-for-purpose-logos bucket) and never committed to
# the repo itself -- see plates-for-purpose/logos-inbox/README.md.
/plates-for-purpose/logos-inbox/*
!/plates-for-purpose/logos-inbox/README.md

# Generated by supabase/sync-plates-for-purpose-restaurants.py -- regenerate,
# don't commit.
/supabase/sync_output.sql

# Generated by supabase/generate-partner-badges.py -- regenerate, don't
# commit (source images live outside the repo; output is uploaded straight
# to Supabase Storage).
/supabase/partner_badges/

# Staging folder for internal business documents (leases, contracts, etc.)
# that must never be served publicly via GitHub Pages. Keep locally only --
# see legal/documents-inbox/README.md.
/legal/documents-inbox/*
!/legal/documents-inbox/README.md

# Claude Code's local, per-machine permission settings -- not meant to be
# shared or version-controlled.
/.claude/settings.local.json
